# ColdEmailOS Environment Variables
# Copy to .env and fill in

# ========== REQUIRED ==========
# Get from: https://app.brevo.com/settings/keys/api
# Free tier: 300 emails/day
BREVO_API_KEY=xkeysib-your-api-key-here

# ========== OPTIONAL ==========
# Webhook URL for Brevo callbacks (auto-configured on deploy)
# WEBHOOK_URL=https://your-app.railway.app/webhooks/brevo

# Database (for production suppression list, analytics)
# DATABASE_URL=sqlite+aiosqlite:///./coldemailos.db
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db

# Redis (for rate limiting, caching)
# REDIS_URL=redis://localhost:6379/0

# Monitoring
# SENTRY_DSN=https://xxx@sentry.io/xxx
# PROMETHEUS_PORT=9090

# Feature flags
# ENABLE_ANALYTICS=true
# ENABLE_WEBHOOK_SYNC=true

# Development
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO
# DEBUG=true